###### Grade baseed on marks 
marks = int(input("enter your makrs:"))

if(marks>=90):
    print("A")
elif(marks>=80 and marks<=90):
    print("B")
elif(marks>=70 and marks<=80):
    print("c")
elif(marks>=60 and marks<=70):
    print('D')
else:
    print("F")


'''
Since these are elif branches, 
by the time you reach elif marks >= 80 and marks <= 90,
you already know marks < 90 (because the first if failed).
So the upper bound check is unnecessary — just elif marks >= 80 is enough.

# Grade based on marks
marks = int(input("Enter your marks: "))

if marks >= 90:
    print("A")
elif marks >= 80:
    print("B")
elif marks >= 70:
    print("C")
elif marks >= 60:
    print("D")
else:
    print("F")
    '''



#Nesting
marks = int(input("Enter your marks:"))
if marks >= 90:
    if(marks>100):
        print("invalid marks")
    else:
        print("A")
elif marks >= 80:
    print("B")
elif marks >= 70:
    print("C")
elif marks >= 60:
    print("D")
elif marks < 0:
    print("invalid marks")
else:
    print("F")



